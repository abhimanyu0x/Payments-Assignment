<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="20261008082658159" author="Abhimanyu">
        <createTable schemaName="notifications" tableName="webhook_endpoints">
            <column name="id" type="uuid" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="business_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_webhook_endpoints_business" references="identity.businesses(id)"/>
            </column>
            <column name="url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="secret_ciphertext" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="20261008082658162" author="Abhimanyu">
        <addUniqueConstraint schemaName="notifications" tableName="webhook_endpoints" columnNames="business_id, id" constraintName="webhook_endpoints_business_id_id_key"/>
        <createIndex schemaName="notifications" tableName="webhook_endpoints" indexName="endpoints_business">
            <column name="business_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="20261008145406512" author="Abhimanyu">
        <createIndex schemaName="notifications" tableName="webhook_endpoints" indexName="one_active_endpoint_per_url" unique="true">
            <column name="business_id"/>
            <column name="url"/>
        </createIndex>
        <modifySql dbms="postgresql">
            <append value=" WHERE active"/>
        </modifySql>
    </changeSet>
</databaseChangeLog>
