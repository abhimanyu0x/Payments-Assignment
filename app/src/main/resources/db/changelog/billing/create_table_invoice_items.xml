<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="20261008082658141" author="Abhimanyu">
        <createTable schemaName="billing" tableName="invoice_items">
            <column name="id" type="uuid" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="invoice_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_invoice_items_invoice" references="billing.invoices(id)"/>
            </column>
            <column name="position" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="unit_amount_cents" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <modifySql dbms="postgresql">
            <regExpReplace replace="\)$" with=", CONSTRAINT invoice_items_quantity_check CHECK (quantity BETWEEN 1 AND 10000), CONSTRAINT invoice_items_unit_amount_cents_check CHECK (unit_amount_cents BETWEEN 0 AND 1000000000000))"/>
        </modifySql>
    </changeSet>
    <changeSet id="20261008082658143" author="Abhimanyu">
        <addUniqueConstraint schemaName="billing" tableName="invoice_items" columnNames="invoice_id, position" constraintName="invoice_items_invoice_id_position_key"/>
    </changeSet>
</databaseChangeLog>
