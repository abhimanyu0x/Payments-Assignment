<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="20261008082658135" author="Abhimanyu">
        <createTable schemaName="billing" tableName="invoices">
            <column name="id" type="uuid" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="business_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_invoices_business" references="identity.businesses(id)"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="text" defaultValue="open">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="text" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount_cents" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <modifySql dbms="postgresql">
            <regExpReplace replace="\)$" with=", CONSTRAINT invoices_state_check CHECK (state IN ('open', 'paid')), CONSTRAINT invoices_currency_check CHECK (currency = 'USD'), CONSTRAINT invoices_total_amount_cents_check CHECK (total_amount_cents BETWEEN 1 AND 1000000000000), CONSTRAINT invoices_paid_at_check CHECK ((state = 'paid') = (paid_at IS NOT NULL)))"/>
        </modifySql>
    </changeSet>
    <changeSet id="20261008082658138" author="Abhimanyu">
        <addUniqueConstraint schemaName="billing" tableName="invoices" columnNames="business_id, id" constraintName="invoices_business_id_id_key"/>
        <addForeignKeyConstraint baseTableSchemaName="billing" baseTableName="invoices" baseColumnNames="business_id, customer_id" referencedTableSchemaName="customers" referencedTableName="customers" referencedColumnNames="business_id, id" constraintName="fk_invoices_customer"/>
        <createIndex schemaName="billing" tableName="invoices" indexName="invoices_list">
            <column name="business_id"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
        <createIndex schemaName="billing" tableName="invoices" indexName="invoices_state_list">
            <column name="business_id"/>
            <column name="state"/>
            <column name="created_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
